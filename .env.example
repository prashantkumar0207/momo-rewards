# Copy to .env (or set these in your hosting dashboard). All optional.

# Port the server listens on (hosts like Render set this for you)
PORT=3000

# --- Database: choose ONE ---
# 1) SQLite file (default). Put it on a persistent disk in production.
DATA_DIR=./data
# 2) PostgreSQL (e.g. free Neon database). If set, DATA_DIR is ignored.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Protects the one-time owner setup screen until you complete it.
# SETUP_CODE=choose-something-secret

# Your public address, used in card links/QRs (auto-detected if not set)
# PUBLIC_URL=https://momo.example.com
